root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.{cs,csx}]
indent_size = 4
dotnet_sort_system_directives_first = true
csharp_new_line_before_open_brace = all

[*.{csproj,props,targets,sln,xml,config}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[{*.yml,*.yaml,*.json,*.jsonc}]
indent_size = 2
