@inject CurrentUser Current
@model AdminUsersViewModel
@{
    ViewData["Title"] = "People";
    var me = await Current.GetAsync();
}

<div class="dash-head">
    <div>
        <span class="eyebrow">Marketplace steward</span>
        <h2>People in the chain.</h2>
        <p>@Model.Users.Count account@(Model.Users.Count == 1 ? "" : "s") shown · manage roles and access carefully.</p>
    </div>
    <div class="dash-actions">
        <a class="btn btn-outline btn-sm" asp-controller="Admin" asp-action="Orders">
            <svg class="icon" aria-hidden="true"><use href="/media/icons.svg#i-layers"></use></svg>
            All orders
        </a>
        <a class="btn btn-primary btn-sm" asp-controller="Marketplace" asp-action="Index">
            <svg class="icon" aria-hidden="true"><use href="/media/icons.svg#i-basket"></use></svg>
            Marketplace
        </a>
    </div>
</div>

<div class="stat-grid cols-5">
    <div class="stat-card">
        <div class="stat-top"><span class="stat-label">Farmers</span><span class="icon-badge"><svg class="icon" aria-hidden="true"><use href="/media/icons.svg#i-sprout"></use></svg></span></div>
        <div class="stat-value" data-count="@Model.Farmers">@Model.Farmers</div>
    </div>
    <div class="stat-card amber">
        <div class="stat-top"><span class="stat-label">Distributors</span><span class="icon-badge amber"><svg class="icon" aria-hidden="true"><use href="/media/icons.svg#i-truck"></use></svg></span></div>
        <div class="stat-value" data-count="@Model.Distributors">@Model.Distributors</div>
    </div>
    <div class="stat-card">
        <div class="stat-top"><span class="stat-label">Retailers</span><span class="icon-badge"><svg class="icon" aria-hidden="true"><use href="/media/icons.svg#i-store"></use></svg></span></div>
        <div class="stat-value" data-count="@Model.Retailers">@Model.Retailers</div>
    </div>
    <div class="stat-card amber">
        <div class="stat-top"><span class="stat-label">Customers</span><span class="icon-badge amber"><svg class="icon" aria-hidden="true"><use href="/media/icons.svg#i-home"></use></svg></span></div>
        <div class="stat-value" data-count="@Model.Customers">@Model.Customers</div>
    </div>
    <div class="stat-card">
        <div class="stat-top"><span class="stat-label">Admins</span><span class="icon-badge"><svg class="icon" aria-hidden="true"><use href="/media/icons.svg#i-shield"></use></svg></span></div>
        <div class="stat-value" data-count="@Model.Admins">@Model.Admins</div>
    </div>
</div>

<form class="filter-bar" method="get" asp-controller="Admin" asp-action="Users" role="search">
    <div class="search-field grow">
        <svg class="icon" aria-hidden="true"><use href="/media/icons.svg#i-search"></use></svg>
        <input class="input" type="search" name="search" value="@Model.Search" placeholder="Search by name, email, username or store…" aria-label="Search people" />
    </div>
    <select class="select" name="role" aria-label="Filter by role">
        <option value="">All roles</option>
        @foreach (var role in Enum.GetValues<UserRole>())
        {
            <option value="@role" selected="@(Model.Role == role)">@role.ToDisplay()</option>
        }
    </select>
    <button class="btn btn-primary" type="submit">
        <svg class="icon" aria-hidden="true"><use href="/media/icons.svg#i-filter"></use></svg>
        Filter
    </button>
</form>

<div class="panel">
    <div class="panel-head">
        <h4>Accounts</h4>
        <span class="badge badge-forest">@Model.Users.Count shown</span>
    </div>
    <div class="panel-body flush">
        @if (Model.Users.Count > 0)
        {
            <div class="table-wrap">
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>Person</th>
                            <th>Role</th>
                            <th>Location</th>
                            <th>Joined</th>
                            <th>Status</th>
                            <th>Change role</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var user in Model.Users)
                        {
                            var isSelf = me?.Id == user.Id;
                            <tr>
                                <td>
                                    <div class="table-product">
                                        @if (!string.IsNullOrWhiteSpace(user.AvatarUrl))
                                        {
                                            <img src="@user.AvatarUrl" alt="" style="border-radius:50%" />
                                        }
                                        else
                                        {
                                            <span class="avatar-fallback">@user.Initials</span>
                                        }
                                        <div>
                                            <strong>@user.DisplayName @(isSelf ? "(you)" : "")</strong>
                                            <span>@user.Email</span>
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    <span class="badge @(user.Role == UserRole.Admin ? "badge-forest" : user.Role == UserRole.Customer ? "badge-muted" : "badge-warn")">
                                        @user.Role.ToDisplay()
                                    </span>
                                    @if (!string.IsNullOrWhiteSpace(user.StoreName))
                                    {
                                        <div class="text-xs text-muted">@user.StoreName</div>
                                    }
                                </td>
                                <td class="text-sm">@(string.IsNullOrWhiteSpace(user.State) ? "—" : user.State)</td>
                                <td class="text-xs text-muted">@user.CreatedAt.ToString("dd MMM yyyy")</td>
                                <td>
                                    @if (user.IsActive)
                                    {
                                        <span class="badge badge-success"><span class="dot"></span>Active</span>
                                    }
                                    else
                                    {
                                        <span class="badge badge-danger">Disabled</span>
                                    }
                                </td>
                                <td>
                                    @if (isSelf)
                                    {
                                        <span class="text-xs text-muted">Can't change own role</span>
                                    }
                                    else
                                    {
                                        <form method="post" asp-controller="Admin" asp-action="SetRole" asp-route-id="@user.Id" class="row" style="gap:.35rem">
                                            @Html.AntiForgeryToken()
                                            <select class="select" name="role" aria-label="Role for @user.DisplayName" style="padding:.35rem .6rem;font-size:.78rem;min-width:120px">
                                                @foreach (var role in Enum.GetValues<UserRole>())
                                                {
                                                    <option value="@role" selected="@(user.Role == role)">@role.ToDisplay()</option>
                                                }
                                            </select>
                                            <button class="btn-icon" type="submit" aria-label="Save role for @user.DisplayName">
                                                <svg class="icon" aria-hidden="true"><use href="/media/icons.svg#i-check"></use></svg>
                                            </button>
                                        </form>
                                    }
                                </td>
                                <td>
                                    <div class="table-actions">
                                        @if (!isSelf)
                                        {
                                            <form method="post" asp-controller="Admin" asp-action="ToggleActive" asp-route-id="@user.Id">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="isActive" value="@((!user.IsActive).ToString().ToLowerInvariant())" />
                                                <button class="btn-icon" type="submit" aria-label="@(user.IsActive ? "Deactivate" : "Reactivate") @user.DisplayName">
                                                    <svg class="icon" aria-hidden="true"><use href="/media/icons.svg#@(user.IsActive ? "i-close" : "i-check")"></use></svg>
                                                </button>
                                            </form>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="empty-state" style="border:0;padding:3rem 1rem">
                <span class="icon-badge"><svg class="icon" aria-hidden="true"><use href="/media/icons.svg#i-users"></use></svg></span>
                <h3>No accounts match</h3>
                <p>Try a different search term or role filter.</p>
                <a class="btn btn-primary" asp-controller="Admin" asp-action="Users">Clear filters</a>
            </div>
        }
    </div>
</div>
